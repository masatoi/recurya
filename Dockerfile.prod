# syntax=docker/dockerfile:1
# Production image for recurya: run from source (SBCL + qlot), like the dev
# environment but without swank/cl-mcp. This is the proven execution path.
# (A save-lisp-and-die executable SIGSEGV-crashed in the DB-connect path, so we
# load the system from source at container start instead.)

ARG SBCL_VERSION=2.5.10
ARG QLOT_VERSION=1.7.5

FROM fukamachi/sbcl:${SBCL_VERSION}-debian
ARG QLOT_VERSION

# git for qlot; libssl/libffi for cl+ssl (OAuth HTTPS); tini for signal-safe PID 1.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git libssl-dev libffi-dev gcc libc6-dev ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    ln -snf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime

# Non-root user with a real shell/home (roswell + qlot need $HOME).
RUN groupadd -g 1000 app && useradd -u 1000 -g app -m -s /bin/bash app
USER app
ENV HOME=/home/app
RUN ros setup && \
    ros -e '(ql:update-dist "quicklisp" :prompt nil)' && \
    ros install "fukamachi/qlot/${QLOT_VERSION}"
ENV PATH="/home/app/.roswell/bin:${PATH}"

WORKDIR /app
# Dependency layer first for caching (.qlot is generated here; keep it out of the
# COPY below via .dockerignore so the reproducible qlot install result is used).
COPY --chown=app:app qlfile qlfile.lock ./
RUN qlot install

# Project sources.
COPY --chown=app:app . .

# Precompile so container startup is load-only (fasls are cached in this layer).
# uax-15 is a lazy dependency of postmodern's SCRAM-SHA-256 auth (SASLprep
# Unicode normalization); load it here so container boot does not fetch it from
# the internet during the first DB connect.
RUN qlot exec ros run -e '(ql:quickload :recurya)' -e '(ql:quickload :uax-15)' -e '(uiop:quit)'

ENV PORT=13000 \
    TZ=Asia/Tokyo \
    APP_ENV=production
EXPOSE 13000

# tini as PID 1 forwards SIGTERM (docker stop) to the whole process group so
# recurya/main:recurya-main shuts the server down gracefully.
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
# Run from source; cap the SBCL heap for the 2 GiB VPS. recurya-main connects the
# DB, seeds official content, starts Hunchentoot, and blocks until SIGTERM.
CMD ["qlot", "exec", "ros", "dynamic-space-size=1024", "run", \
     "-e", "(setf sb-impl::*default-external-format* :utf-8)", \
     "-e", "(ql:quickload :recurya)", \
     "-e", "(recurya/main:recurya-main)"]
